<?xml version="1.0" encoding="utf-8"?>
<!-- The station coming in. With widget_out it is a staggered crossfade: this one is fully there
     before the other has gone, so the card never thins to the dark behind it, whichever page is on top. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="130"
    android:fromAlpha="0"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:toAlpha="1" />

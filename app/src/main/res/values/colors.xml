<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's "match my phone" colours. They point at the system's Material You tones and are
     resolved by the launcher, not baked into the picture, so a new wallpaper or dark mode shows at once. -->
<resources>
    <color name="phone_ground">@android:color/system_accent1_100</color>
    <color name="phone_ink">@android:color/system_accent1_900</color>
    <color name="phone_panel">@android:color/system_neutral1_50</color>
    <color name="phone_panel_ink">@android:color/system_neutral1_900</color>
    <color name="phone_accent">@android:color/system_accent1_600</color>
</resources>
